<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Keystore keys never leave the device, so a restored
     copy of flutter_secure_storage can't be decrypted; keep it out of backups. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
</full-backup-content>
