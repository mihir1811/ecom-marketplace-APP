<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP so a local backend
     (http://10.0.2.2:3000, LAN IPs) keeps working during development. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
